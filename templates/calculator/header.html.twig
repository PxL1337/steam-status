{# templates/calculator/header.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Account header{% endblock %}

{% block body %}
    <div class="steam-green" data-controller="theme-switch">
        <div class="container py-4">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h1 class="mb-0 d-flex align-items-center gap-2">
                    <twig:ux:icon name="mdi:account" class="icon-gauge-large" /> Account
                </h1>
                <button class="btn btn-sm btn-secondary" data-action="theme-switch#toggleTheme">Switch thème</button>
            </div>

            <form class="row gy-2 gx-2 mb-3" method="get">
                <div class="col-12 col-md-10">
                    <input class="form-control" name="q" value="{{ q }}" placeholder="SteamID / vanity / URL / friend code CS2"/>
                </div>
                <div class="col-12 col-md-2 d-grid">
                    <button class="btn btn-primary">Charger</button>
                </div>
            </form>

            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}

            {% if user %}
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="text-muted">
                        Dernière MAJ : {{ user.updatedAt|date('d-m-Y H:i') }}
                    </div>
                    {% if updateQueued %}
                        <span class="badge bg-info">Mise à jour en arrière-plan…</span>
                    {% endif %}
                </div>
                <div class="card">
                    <div class="card-body d-flex align-items-center gap-3">
                        {% if user.avatar %}
                            <img src="{{ user.avatar }}" alt="" style="width:72px;height:72px;border-radius:8px;">
                        {% endif %}
                        <div class="flex-grow-1">
                            <div class="fs-4 fw-bold">{{ user.personaName ?? user.steamId }}</div>
                            <div class="text-muted">
                                {{ user.country ?? '??' }} ·
                                Created: {{ user.timeCreated ? user.timeCreated|date('d-m-Y') : 'unknown' }}
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold">Level</div>
                            <div class="fs-4">{{ user.level }}</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold">VAC</div>
                            <div>{{ user.vacBanned ? 'Banned (' ~ user.vacBanCount ~ ')' : 'In good standing' }}</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold">Community</div>
                            <div>{{ user.communityBanned ? 'Banned' : 'In good standing' }}</div>
                        </div>
                    </div>
                </div>
            {% endif %}

        </div>
    </div>
{% endblock %}
